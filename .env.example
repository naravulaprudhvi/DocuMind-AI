# ==============================================================================
# DocuMind AI - Environment Configuration Template
# Copy this file to `.env` and fill in your real values before starting the app:
#   cp .env.example .env
# ==============================================================================

# Application Security
SECRET_KEY=replace-with-a-secure-random-secret-key

# ==============================================================================
# Persistent Application Cloud Database (Recommended: Supabase or Neon PostgreSQL)
# Prevents accounts from disappearing when cloud containers restart or sleep.
# From Supabase: Project Settings -> Database -> Connection string (URI)
# Example: postgresql://postgres.xxxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# ==============================================================================
DATABASE_URL=

# Fallback: Local MySQL Relational Database (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_USER=documind_user
DB_PASSWORD=your_secure_db_password
DB_NAME=documind_db

# LLM Providers (Google Gemini or Local Ollama)
# Get an API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini

# Local Ollama Configuration (Optional - for 100% offline local LLM inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Performance & Caching
ENABLE_QUERY_CACHE=true
QUERY_CACHE_TTL_SECONDS=600
